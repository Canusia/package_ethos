# Ethos Integration API base URL (default shown). Override for test tenants.
ETHOS_BASE_URL=https://integrate.elluciancloud.com
# The Colleague/Ethos Application API key (same value as Django COLLEAGUE_AUTH_CODE).
ETHOS_API_KEY=
# Request timeout in seconds.
ETHOS_TIMEOUT=30
# Optional JSON map of SIS GUIDs (rarely needed for read-only commands).
ETHOS_GUIDS_JSON=
